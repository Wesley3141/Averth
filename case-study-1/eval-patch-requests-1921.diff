@@ -0,0 +1,70 @@
+#!/usr/bin/env python
+import requests
+
+def test_session_header_none_removal():
+    print("=== Test 1: Setting session header to None ===")
+    session = requests.Session()
+    print("Original headers:", dict(session.headers))
+    
+    # Set a header to None
+    session.headers['Accept-Encoding'] = None
+    print("Session headers after setting to None:", dict(session.headers))
+    
+    # Prepare a request
+    req = requests.Request('GET', 'http://httpbin.org/get')
+    prepared = session.prepare_request(req)
+    print("Prepared request headers:", dict(prepared.headers))
+    print("Accept-Encoding removed:", 'Accept-Encoding' not in prepared.headers)
+    print()
+
+def test_request_header_none_removal():
+    print("=== Test 2: Setting request header to None (should still work) ===")
+    session = requests.Session()
+    
+    # Prepare a request with None header
+    req = requests.Request('GET', 'http://httpbin.org/get', headers={'Accept-Encoding': None})
+    prepared = session.prepare_request(req)
+    print("Prepared request headers:", dict(prepared.headers))
+    print("Accept-Encoding removed:", 'Accept-Encoding' not in prepared.headers)
+    print()
+
+def test_both_none():
+    print("=== Test 3: Both session and request headers set to None ===")
+    session = requests.Session()
+    session.headers['Accept-Encoding'] = None
+    
+    req = requests.Request('GET', 'http://httpbin.org/get', headers={'Accept-Encoding': None})
+    prepared = session.prepare_request(req)
+    print("Prepared request headers:", dict(prepared.headers))
+    print("Accept-Encoding removed:", 'Accept-Encoding' not in prepared.headers)
+    print()
+
+def test_request_overrides_session():
+    print("=== Test 4: Request header overrides session header ===")
+    session = requests.Session()
+    session.headers['Accept-Encoding'] = 'gzip'
+    
+    req = requests.Request('GET', 'http://httpbin.org/get', headers={'Accept-Encoding': None})
+    prepared = session.prepare_request(req)
+    print("Prepared request headers:", dict(prepared.headers))
+    print("Accept-Encoding removed:", 'Accept-Encoding' not in prepared.headers)
+    print()
+
+def test_session_overrides_with_none():
+    print("=== Test 5: Session None removes default header ===")
+    session = requests.Session()
+    # Accept-Encoding has a default value, setting to None should remove it
+    session.headers['Accept-Encoding'] = None
+    
+    req = requests.Request('GET', 'http://httpbin.org/get')
+    prepared = session.prepare_request(req)
+    print("Prepared request headers:", dict(prepared.headers))
+    print("Accept-Encoding removed:", 'Accept-Encoding' not in prepared.headers)
+    print()
+
+if __name__ == '__main__':
+    test_session_header_none_removal()
+    test_request_header_none_removal()
+    test_both_none()
+    test_request_overrides_session()
+    test_session_overrides_with_none()
