+#!/usr/bin/env python
+import requests
+
+def test_normal_header_functionality():
+    print("=== Test: Normal header functionality still works ===")
+    session = requests.Session()
+    
+    # Set a normal header value
+    session.headers['Custom-Header'] = 'session-value'
+    
+    # Request with different value for same header
+    req = requests.Request('GET', 'http://httpbin.org/get', headers={'Custom-Header': 'request-value'})
+    prepared = session.prepare_request(req)
+    
+    print("Prepared request headers:", dict(prepared.headers))
+    print("Custom-Header value:", prepared.headers.get('Custom-Header'))
+    print("Request header overrides session header:", prepared.headers.get('Custom-Header') == 'request-value')
+    
+    # Test session header without request override
+    req2 = requests.Request('GET', 'http://httpbin.org/get')
+    prepared2 = session.prepare_request(req2)
+    print("Session header used when no request override:", prepared2.headers.get('Custom-Header') == 'session-value')
+
+if __name__ == '__main__':
+    test_normal_header_functionality()